     },
     "error": {
      "$ref": "#/components/schemas/ErrorCode"
     },
     "arg": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
     },
     "state": {
      "type": "string"
     },
     "cause": {
      "type": "string",
      "enum": [
       "set",
       "pulse",
       "bounce",
       "ttl",
