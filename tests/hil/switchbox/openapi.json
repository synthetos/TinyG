 "x-serial-protocol": {
  "baud": 115200,
  "framing": "8N1. One JSON object per line, terminated by \\n (\\r also ends a line). Request lines up to 1024 bytes; longer ones get line_too_long. Blank lines are ignored; other non-JSON lines get bad_json with id null.",
  "request": {
   "$ref": "#/components/schemas/Request"
  },
  "response": {
   "$ref": "#/components/schemas/Response"
  },
  "params": "An op's parameters are its requestBody members plus its path parameter (name) and query parameters (since, limit), all at the top level of the request object next to id and op. Unknown parameters are rejected (unknown_param).",
  "events": "Only after a subscribe op: Event (or Dropped) objects interleaved with responses. Responses carry id, events carry event.",
  "boot": "After every reset the board prints one Event line with event=boot, plus api_version, config (stored, default, or invalid: <why>) and fs. The ESP8266 ROM first prints a banner at 74880 baud, which reads as garbage at 115200; clients skip lines that are not JSON objects.",
  "reset": "The CP2104's DTR and RTS lines drive the ESP8266 EN/GPIO0 auto-reset transistors. Open the port with both deasserted and keep them deasserted, or the board resets. getInfo's uptime_ms and boot_id tell whether it did.",
  "operations": {
   "subscribe": {
    "operationId": "subscribe",
    "summary": "Start or stop asynchronous event lines on this serial connection",
    "description": "Events recorded from the reply on are sent as lines (at most 2 per main-loop pass); a subscriber that falls more than 128 events behind gets a Dropped line. WebSocket clients always receive events; HTTP has no event stream.",
    "x-transports": [
     "serial",
     "ws"
    ],
    "x-logged": "always",
    "params": {
     "$ref": "#/components/schemas/SubscribeParams"
    },
    "result": {
     "$ref": "#/components/schemas/SubscribeResult"
    }
   }
  }
 },
 "x-websocket": {
  "path": "/ws",
  "framing": "Text messages; client requests use the serial framing (Request) and get a Response.",
  "on_connect": "A Snapshot message, then up to 16 recent events.",
  "server_messages": {
   "oneOf": [
    {
     "$ref": "#/components/schemas/Response"
    },
    {
     "$ref": "#/components/schemas/Event"
    },
    {
     "$ref": "#/components/schemas/Dropped"
    },
    {
     "$ref": "#/components/schemas/Snapshot"
    },
    {
     "$ref": "#/components/schemas/StateMessage"
    }
   ]
  },
  "throttle": "Events are pushed at most 6 per client every 20 ms, and only while the client's TCP buffer has room, so a slow client never blocks the board. A client more than 24 events behind skips to the newest 4 and gets a Dropped message followed by a StateMessage. Pushes pause while free heap is below 8 KB.",
  "limits": "At most 3 clients; incoming messages up to 2048 bytes. getSpec is not available here (GET /openapi.json)."
 },
 "x-limits": {
  "channels": 8,
  "event_ring": 128,
  "events_page_max": 32,
  "ttl_ms_max": 3600000,
  "pulse_ms_max": 60000,
  "pulse_us_max": 1000000,
  "bounce_edges_max": 64,
  "bounce_interval_us": [
   2,
   100000
  ],
  "inline_us": 50,
  "note": "Numeric parameters out of range are clamped and listed in the result's clamped array; negative, non-integer and wrongly typed values are rejected."
 },
 "x-future": {
  "mount": "Reserved: a mountChannel op that counts TinyG step/dir pulses on two input GPIOs and trips a channel at a step position. Not implemented; see the README for the ESP8266 interrupt-rate limits."
 }
}
