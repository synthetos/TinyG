    "x-transports": [
     "serial",
     "http",
     "ws"
    ],
    "x-logged": "always",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SetChannelResult"
        }
       }
      }
     },
     "400": {
      "description": "Invalid request (see error.code)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorBody"
        }
       }
      }
     },
     "404": {
      "description": "Unknown channel",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorBody"
        }
