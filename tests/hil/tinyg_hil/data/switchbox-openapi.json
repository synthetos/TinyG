      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorBody"
        }
       }
      }
     },
     "409": {
      "description": "Channel busy or already in the requested state",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorBody"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "name",
      "in": "path",
      "required": true,
      "description": "Channel name, e.g. xmin.",
      "schema": {
       "$ref": "#/components/schemas/ChannelName"
