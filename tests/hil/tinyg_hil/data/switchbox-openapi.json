 "components": {
  "schemas": {
   "ChannelName": {
    "type": "string",
    "pattern": "^[A-Za-z0-9_.-]{1,15}$",
    "description": "Free string; tests use <axis><min|max>, e.g. xmin."
   },
   "Gpio": {
    "type": "integer",
    "enum": [
     0,
     2,
     4,
     5,
     12,
     13,
     14,
     16
    ],
    "description": "Usable ESP8266 GPIOs. 0 and 2 are boot-strap pins (see Config caveat)."
   },
   "SwitchType": {
    "type": "string",
    "enum": [
     "no",
     "nc"
    ]
   },
   "ContactState": {
    "type": "string",
    "enum": [
     "closed",
     "open"
    ],
    "description": "closed = pin sinks the line to GND; open = pin high-Z."
   },
   "Action": {
    "type": "string",
    "enum": [
     "trip",
     "release"
    ],
    "description": "Semantic: NO trip = closed; NC trip = open."
   },
   "Clamped": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "description": "Parameters that were out of range and clamped (present only if any)."
   },
   "ErrorCode": {
    "type": "string",
    "enum": [
     "bad_json",
     "bad_request",
     "unknown_op",
     "unknown_param",
     "missing_param",
     "bad_param",
     "conflicting_params",
     "unknown_channel",
     "no_change",
     "busy",
     "invalid_config",
     "line_too_long",
     "unsupported_transport",
     "storage"
    ]
   },
   "Error": {
    "type": "object",
    "required": [
     "code",
     "msg"
    ],
    "properties": {
     "code": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/ErrorCode"
       },
       {
        "const": "not_found"
       }
      ]
     },
     "msg": {
      "type": "string"
     }
    }
   },
   "ErrorBody": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "$ref": "#/components/schemas/Error"
     }
    }
   },
   "ChannelState": {
    "type": "object",
    "required": [
     "name",
     "gpio",
     "type",
     "state",
     "tripped",
     "level",
     "since_us",
     "pending",
     "ttl_until_us",
     "warning"
    ],
    "properties": {
     "name": {
      "$ref": "#/components/schemas/ChannelName"
     },
     "gpio": {
      "$ref": "#/components/schemas/Gpio"
     },
     "type": {
      "$ref": "#/components/schemas/SwitchType"
     },
     "state": {
      "$ref": "#/components/schemas/ContactState"
     },
     "tripped": {
      "type": "boolean",
      "description": "Semantic state commanded (from state and type)."
     },
     "level": {
      "type": "integer",
      "enum": [
       0,
       1
      ],
      "description": "Actual line level read now."
     },
     "since_us": {
      "type": "integer",
      "minimum": 0,
      "description": "Time of the last contact change."
     },
     "pending": {
      "oneOf": [
       {
        "type": "null"
       },
       {
        "type": "object",
        "properties": {
         "kind": {
          "type": "string",
          "enum": [
           "pulse",
           "bounce"
          ]
         },
         "until_us": {
          "type": "integer",
          "minimum": 0
         }
        }
       }
      ]
     },
     "ttl_until_us": {
      "type": [
       "integer",
       "null"
      ],
      "minimum": 0,
      "description": "When the ttl will open the contact."
     },
     "warning": {
      "type": [
       "string",
       "null"
      ],
      "description": "Readback warning, not an error: closed but high (contention or fault); open but low (a real switch, wiring fault, or TinyG unpowered/disconnected); open line toggling by itself (floating input)."
     }
    }
   },
   "ChannelConfig": {
    "type": "object",
    "required": [
     "name",
     "gpio"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "$ref": "#/components/schemas/ChannelName"
     },
     "gpio": {
      "$ref": "#/components/schemas/Gpio"
     },
     "type": {
      "$ref": "#/components/schemas/SwitchType",
      "default": "no"
     },
     "caveat": {
      "type": "string",
      "readOnly": true,
      "description": "Set for boot-strap pins; ignored on input."
     }
    }
   },
   "Config": {
    "type": "object",
    "required": [
     "channels",
     "is_default"
    ],
    "properties": {
     "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
       "$ref": "#/components/schemas/ChannelConfig"
      }
     },
     "is_default": {
      "type": "boolean"
     }
    }
   },
   "Info": {
    "type": "object",
    "required": [
     "fw_version",
     "api_version",
     "uptime_ms",
     "uptime_us",
     "boot_id"
    ],
    "properties": {
     "fw_version": {
      "type": "string"
     },
     "api_version": {
      "type": "string"
     },
     "spec_sha256": {
      "type": "string",
      "description": "SHA-256 of the minified embedded spec."
     },
     "uptime_ms": {
      "type": "integer",
      "minimum": 0
     },
     "uptime_us": {
      "type": "integer",
      "minimum": 0
     },
